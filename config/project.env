# ---------------------------------------------------------------------------
# Single source of truth for every script and Terraform layer in this repo.
# Sourced by scripts/de.sh. Exported TF_VAR_* values feed Terraform variables
# directly, so the region can never drift between the CLI and Terraform.
# ---------------------------------------------------------------------------

# Resource name prefix. Kept as the brief specifies it (section 4, Day 1-2):
# the graded resource names are de-training-* and training_db, and renaming
# them would be a deviation for no benefit.
export PROJECT="de-training"

# Domain identity. Used for tags, documentation and descriptive labels - the
# places where the name should say what the system is for rather than which
# exercise produced it.
export PROJECT_TAG="retail-data-pipeline"
export TF_VAR_project_tag="$PROJECT_TAG"

# Region. Pinned here and nowhere else. Matches the AWS CLI default region so
# that ad-hoc `aws` commands and Terraform always target the same account/region.
export AWS_REGION="us-east-2"
export AWS_DEFAULT_REGION="$AWS_REGION"

# Glue runtime (Spark 3.5 / Python 3.11)
export GLUE_VERSION="5.0"

# Terraform variable passthrough
export TF_VAR_project="$PROJECT"
export TF_VAR_region="$AWS_REGION"

# Monthly budget ceiling in USD; alerts fire at 50 / 80 / 100%.
export TF_VAR_monthly_budget_usd="50"

# Daily ceiling. A normal working session costs about $4, so this only
# fires when a teardown was missed or something is running that should not be.
export TF_VAR_daily_budget_usd="5"

# Days after which objects in the raw/processed/curated/quarantine prefixes
# expire. Keeps the lake cheap between rebuild cycles.
export TF_VAR_lake_expiration_days="7"

# Regions swept for stray resources by `de.sh verify`.
export SWEEP_REGIONS="us-east-1 us-east-2 us-west-2 eu-west-1"

# ---------------------------------------------------------------------------
# This is the ONLY env file. It is safe to commit: nothing personal lives here.
#
# The one value that must stay out of version control - the budget alert
# address - lives in infrastructure/persistent/terraform.tfvars, which the
# *.tfvars gitignore rule already covers and Terraform loads automatically.
# Copy terraform.tfvars.example to get started.
# ---------------------------------------------------------------------------

# Shared Terraform provider cache. Without it each layer downloads its own
# ~860 MB copy of the AWS provider - 1.7 GB of identical bytes on disk for two
# layers that pin the same version.
export TF_PLUGIN_CACHE_DIR="${TF_PLUGIN_CACHE_DIR:-$HOME/.terraform.d/plugin-cache}"

# Glue Data Catalog database. Named by the training brief, so it does NOT
# carry the project prefix - verify_teardown.sh checks it by exact name.
export GLUE_DATABASE="training_db"
export TF_VAR_glue_database="$GLUE_DATABASE"
